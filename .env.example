# ---------------------------------------------------------------------------
# docker-compose environment
#
# Copy to `.env` to change ports or credentials. Every value here has a working
# default, so `docker compose up --build` works with no .env at all.
# ---------------------------------------------------------------------------

POSTGRES_USER=pianonobil
POSTGRES_PASSWORD=pianonobil
POSTGRES_DB=pianonobil
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=3000

# Origins allowed to call the API from a browser. localhost and 127.0.0.1 are
# different origins, so both are listed.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# The API URL baked into the browser bundle. Change this when the stack is not
# reached at localhost — it must be the URL the *browser* can resolve.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

ENVIRONMENT=development
