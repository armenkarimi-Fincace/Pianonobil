# ---------------------------------------------------------------------------
# Frontend environment
# ---------------------------------------------------------------------------

# Base URL of the FastAPI backend, as reachable from the *browser*.
# Local development (backend run directly on the host):
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Base URL of the FastAPI backend, as reachable from the Next.js *server*
# (React Server Components / route handlers). Inside docker-compose this is the
# service name rather than localhost. Falls back to NEXT_PUBLIC_API_BASE_URL.
API_BASE_URL=http://localhost:8000

# Set to "1" to run the environment entirely from the bundled fallback catalog
# without contacting the backend at all (useful for design work offline).
NEXT_PUBLIC_OFFLINE_CATALOG=0
