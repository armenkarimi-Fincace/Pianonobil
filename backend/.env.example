# ---------------------------------------------------------------------------
# Backend environment
# ---------------------------------------------------------------------------

# PostgreSQL connection string (SQLAlchemy / psycopg 3 driver).
# Local development against a Postgres on the host:
DATABASE_URL=postgresql+psycopg://pianonobil:pianonobil@localhost:5432/pianonobil

# Inside docker-compose the host is the service name instead:
# DATABASE_URL=postgresql+psycopg://pianonobil:pianonobil@db:5432/pianonobil

# Comma-separated list of origins allowed to call the API from a browser.
# Note that localhost and 127.0.0.1 are different origins to a browser, so both
# are listed: reaching the frontend by the address you did not list is the most
# common cause of a blocked preflight in development.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Seed the catalog tables on startup when they are empty. Safe to leave on:
# it never overwrites rows that already exist.
SEED_ON_STARTUP=1

# Anything other than "production" enables the interactive /docs and /redoc.
ENVIRONMENT=development
